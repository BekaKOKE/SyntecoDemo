# Synteco Demo API — Environment Variables
# Copy to .env (cp .env.example .env). Values below match docker-compose.yml
# in the repository root, so no edits are needed for a local run.

# Database (docker compose service "postgres", host port 5434)
DATABASE_URL="postgresql://synteco:synteco_dev@localhost:5434/synteco"

# JWT
JWT_SECRET="demo-jwt-secret-change-me"
JWT_REFRESH_SECRET="demo-jwt-refresh-secret-change-me"

# Redis (cache; API falls back to in-memory cache if unavailable)
REDIS_URL="redis://:synteco_redis@localhost:6381"

# Typesense (optional, not started by docker-compose.yml — search falls back to PostgreSQL)
TYPESENSE_API_KEY="synteco_dev_key"
TYPESENSE_HOST="localhost"
TYPESENSE_PORT="8109"

# Email: leave SMTP_* empty — notifications are simulated, logged and stored
# in the database (see docs/02-software-design.md).
SMTP_HOST=""
SMTP_USER=""
SMTP_PASS=""

# CORS
CORS_ORIGINS="http://localhost:3001,http://localhost:3002"

# API
PORT=3000
NODE_ENV=development
