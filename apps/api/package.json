{
  "name": "@synteco/api",
  "version": "0.1.0",
  "private": true,
  "description": "Synteco NestJS API — main backend monolith",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "jest --passWithNoTests",
    "test:e2e": "jest --config jest.e2e.config.js --runInBand",
    "test:playwright": "npx playwright test",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:migrate:prod": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:demo": "prisma generate && prisma migrate deploy && prisma db execute --file prisma/demo-data/catalog.sql --schema prisma/schema.prisma && tsx prisma/seed-demo.ts",
    "db:set-admin": "tsx prisma/set-admin.ts",
    "db:create-manager": "tsx prisma/create-manager.ts",
    "db:set-password": "tsx prisma/set-password.ts",
    "catalog:rebuild": "tsx scripts/rebuild-catalog-categories.ts",
    "catalog:rebuild:apply": "tsx scripts/rebuild-catalog-categories.ts --apply",
    "db:studio": "prisma studio",
    "db:reset": "node -e \"if(process.env.NODE_ENV==='production'){console.error('ОТКАЗ: db:reset уничтожает базу. На проде запрещён.');process.exit(1)}\" && prisma migrate reset --force",
    "clean": "rm -rf dist/"
  },
  "dependencies": {
    "@nestjs/bullmq": "^10.1.0",
    "@nestjs/cache-manager": "^3.1.2",
    "@nestjs/common": "^10.3.0",
    "@nestjs/config": "^3.2.0",
    "@nestjs/core": "^10.3.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.0",
    "@nestjs/platform-express": "^10.3.0",
    "@nestjs/platform-socket.io": "^10.4.22",
    "@nestjs/schedule": "^4.0.0",
    "@nestjs/swagger": "^7.3.0",
    "@nestjs/throttler": "^5.1.0",
    "@nestjs/websockets": "^10.4.22",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^6.19.3",
    "@synteco/shared-types": "workspace:*",
    "amqplib": "^0.10.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.7.0",
    "cache-manager-ioredis-yet": "^2.1.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "helmet": "^8.2.0",
    "ioredis": "^5.4.0",
    "minio": "^8.0.7",
    "multer": "^2.1.1",
    "nodemailer": "^6.9.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pg": "^8.21.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "prisma": "~6.19.3",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "socket.io": "^4.8.3",
    "tsx": "^4.7.0",
    "typesense": "^3.0.6",
    "uuid": "^9.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.3.0",
    "@nestjs/schematics": "^10.1.0",
    "@nestjs/testing": "^10.3.0",
    "@playwright/test": "^1.60.0",
    "@types/bcryptjs": "^2.4.0",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.12.0",
    "@types/nodemailer": "^8.0.1",
    "@types/passport-jwt": "^4.0.0",
    "@types/pg": "^8.20.0",
    "@types/uuid": "^9.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "supertest": "^6.3.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.5.0"
  }
}
