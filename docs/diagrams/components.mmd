%% Component / data-flow map. Based on a diagram generated by gitdiagram.com
%% from this repository; Kaspi SDK and Redis added by hand.
flowchart TD

subgraph group_shop["Storefront (apps/web)"]
  node_catalog_ui["Product catalog<br/>[CatalogClient.tsx]"]
  node_cart_ui["Shopping cart<br/>[cart/page.tsx]"]
  node_checkout_ui["Checkout<br/>[checkout/page.tsx]"]
  node_account_ui["Orders & notifications<br/>[accounts/*]"]
end

subgraph group_api["Commerce API (apps/api, NestJS)"]
  node_api["NestJS REST API<br/>[main.ts]"]
  node_auth["Authentication<br/>[auth.service.ts]"]
  node_search["Catalog search<br/>[search.service.ts]"]
  node_products["Product catalog<br/>[products.service.ts]"]
  node_cart["Cart service<br/>[cart.service.ts]"]
  node_pricing["Pricing<br/>[pricing.service.ts]"]
  node_promotions["Promotions — Strategy<br/>[promotions.service.ts]"]
  node_orders["Order workflow<br/>[orders.service.ts]"]
  node_order_cost["Optional services — Decorator<br/>[order-cost/*]"]
  node_inventory["Inventory<br/>[inventory.service.ts]"]
  node_payments["Payments — Adapter<br/>[payments.service.ts]"]
  node_notifications["Notifications — Decorator<br/>[notifications.service.ts]"]
end

subgraph group_operations["Operations (apps/admin)"]
  node_admin_ui["Admin panel<br/>[orders · promotions]"]
  node_admin_client["Admin API client<br/>[client.ts]"]
  node_admin_ops["Admin operations<br/>[admin.service.ts]"]
end

subgraph group_data["Persistence and integrations"]
  node_database[("PostgreSQL")]
  node_typesense[("Typesense")]
  node_redis[("Redis cache")]
  node_gateway_vendors["Simulated payment SDKs<br/>[kaspi-pay.sdk.ts · halyk-epay.sdk.ts]"]
end

node_customer(("Shopper"))
node_staff(("Admin staff"))

node_customer -->|"browses"| node_catalog_ui
node_customer -->|"manages cart"| node_cart_ui
node_customer -->|"checks out"| node_checkout_ui
node_customer -->|"tracks orders"| node_account_ui
node_staff -->|"manages store"| node_admin_ui
node_catalog_ui -->|"requests catalog"| node_api
node_cart_ui -->|"uses REST"| node_api
node_checkout_ui -->|"submits checkout"| node_api
node_account_ui -->|"requests orders"| node_api
node_admin_ui -->|"calls"| node_admin_client
node_admin_client -->|"uses REST"| node_api
node_api -.->|"routes auth"| node_auth
node_api -.->|"routes search"| node_search
node_api -.->|"routes products"| node_products
node_api -->|"routes cart"| node_cart
node_api -->|"routes orders"| node_orders
node_api -->|"routes promotions"| node_promotions
node_api -.->|"caches"| node_redis
node_cart -->|"resolves price"| node_pricing
node_orders -->|"reads cart"| node_cart
node_orders -->|"evaluates promo"| node_promotions
node_orders -->|"builds services"| node_order_cost
node_orders -->|"reserves stock"| node_inventory
node_orders -->|"requests payment"| node_payments
node_orders -->|"notifies changes"| node_notifications
node_orders -->|"persists orders"| node_database
node_cart -->|"persists cart"| node_database
node_products -->|"indexes catalog"| node_typesense
node_search -->|"searches first"| node_typesense
node_search -->|"falls back"| node_database
node_payments -->|"adapts SDKs"| node_gateway_vendors
node_promotions -->|"stores promotions"| node_database
node_admin_ops -.->|"manages records"| node_database

