classDef toneRose fill:#ffe4e6,stroke:#e11d48,stroke-width:1.5px,color:#881337
classDef toneIndigo fill:#e0e7ff,stroke:#4f46e5,stroke-width:1.5px,color:#312e81
class node_catalog_ui,node_cart_ui,node_checkout_ui,node_account_ui toneBlue
class node_api,node_auth,node_search,node_products,node_cart,node_pricing,node_orders,node_inventory toneAmber
class node_promotions,node_order_cost,node_payments,node_notifications tonePattern
