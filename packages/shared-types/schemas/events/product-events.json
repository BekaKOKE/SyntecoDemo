{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.synteco.kz/events/product-events.json",
  "title": "ProductDomainEvents",
  "definitions": {
    "ProductCreated": {
      "type": "object",
      "required": ["type", "productId", "variantId", "title", "brand", "categoryId", "timestamp"],
      "properties": {
        "type": { "const": "product.created" },
        "productId": { "type": "string", "format": "uuid" },
        "variantId": { "type": "string", "minLength": 1 },
        "itemId": { "type": "string", "nullable": true, "description": "Grainger item_id — null if '0'" },
        "title": { "type": "string", "minLength": 2 },
        "brand": { "type": "string" },
        "categoryId": { "type": "string", "format": "uuid" },
        "mpn": { "type": "string", "nullable": true },
        "price": { "$ref": "schemas/common/money.json" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    "ProductCategorized": {
      "type": "object",
      "required": ["type", "productId", "variantId", "categoryId", "confidence", "timestamp"],
      "properties": {
        "type": { "const": "product.categorized" },
        "productId": { "type": "string", "format": "uuid" },
        "variantId": { "type": "string" },
        "categoryId": { "type": "string", "format": "uuid" },
        "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0, "description": "LLM confidence — null if manual" },
        "reasoning": { "type": "string", "nullable": true, "maxLength": 500 },
        "needsReview": { "type": "boolean", "default": false },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    "ProductEnriched": {
      "type": "object",
      "required": ["type", "productId", "timestamp"],
      "properties": {
        "type": { "const": "product.enriched" },
        "productId": { "type": "string", "format": "uuid" },
        "russianDescription": { "type": "string", "nullable": true },
        "russianSpecTable": { "type": "object", "nullable": true, "description": "Key-value spec table in Russian" },
        "metaTitle": { "type": "string", "nullable": true },
        "metaDescription": { "type": "string", "nullable": true },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    "ProductImageProcessed": {
      "type": "object",
      "required": ["type", "productId", "mediaId", "variants", "timestamp"],
      "properties": {
        "type": { "const": "product.image.processed" },
        "productId": { "type": "string", "format": "uuid" },
        "mediaId": { "type": "string", "format": "uuid" },
        "variants": {
          "type": "object",
          "properties": {
            "thumb": { "type": "string", "format": "uri" },
            "card": { "type": "string", "format": "uri" },
            "full": { "type": "string", "format": "uri" }
          },
          "required": ["thumb", "card", "full"]
        },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    }
  }
}
